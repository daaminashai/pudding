{
  "name": "pudding",
  "version": "0.1.0",
  "private": true,
  "description": "Drafts human-sounding replies to unanswered Jelly emails for review and approval in a local dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "vite build --logLevel warn",
    "start": "tsx src/index.ts",
    "scan": "tsx src/index.ts --scan-only",
    "build": "vite build",
    "inspect": "tsx src/inspect.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "capture": "tsx src/capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "node-html-parser": "^9.0.4",
    "openai": "^7.32.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
