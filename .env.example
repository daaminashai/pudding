# --- Marmalade (read-only mirror of Jelly) ---
# Base URL without the /api/rpc suffix, e.g. https://marmalade.example.com
MARMALADE_BASE_URL=
MARMALADE_API_KEY=
# Run `npm run inspect` with this empty to list the mailboxes your key can see.
MAILBOX_ID=

# --- Drafting model: set one key. With both set, Anthropic wins unless LLM_PROVIDER says otherwise. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# LLM_PROVIDER=openai

# --- Drafting ---
# Open conversations with activity in this many days get checked for unanswered emails.
UNANSWERED_LOOKBACK_DAYS=30
# Learn tone and answers from conversations we replied to in this many days (0 = off).
LEARN_FROM_DAYS=180
# At most this many past question/reply pairs go into the prompt.
LEARN_MAX_EXAMPLES=100
# Threads with at least this many messages get a "long thread" flag.
LONG_THREAD_MESSAGES=6

# --- Dashboard ---
DASHBOARD_PORT=4545
# Seconds between replies when sending sign-up confirmations in bulk.
BULK_SEND_GAP_SECONDS=3
# A conversation's address in Jelly with the id replaced by {id}, for the "Open in Jelly" button.
# JELLY_CONVERSATION_URL=

# --- Sending ---
# shadow: approving copies the reply for pasting into Jelly. send: approving sends it through Jelly.
MODE=shadow
# 1 blocks sending. A file named STOP in the working dir does the same.
KILL_SWITCH=0
# Your Jelly login, so Approve can send. To set it:
#   1. In Chrome, open any conversation in Jelly and press Cmd-Option-I.
#   2. Open the Network tab and type method:POST in the filter box.
#   3. Click Reply in Jelly (don't send anything). A row appears.
#   4. Right-click it > Copy > Copy as cURL, then run: npm run capture -- --save-cookie
#   5. Set MODE=send above, delete any STOP file, and restart.
# Signing out of Jelly ends this login, so redo these steps after signing back in.
# Never paste the copied cURL anywhere else: it contains your login.
JELLY_SESSION_COOKIE=
# Posted to if the Jelly login stops working.
SLACK_WEBHOOK_URL=
# JELLY_BASE_URL=https://app.letsjelly.com
# JELLY_TEAM=hack-club
# JELLY_TIMEZONE=   (defaults to this computer's time zone)

# --- Paths (defaults shown) ---
# DATA_DIR=./data
# KNOWLEDGE_DIR=./knowledge
